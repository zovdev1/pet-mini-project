{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --ext .js,.jsx .",
